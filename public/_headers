# Cloudflare Pages response headers.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https://*.mux.com; connect-src 'self' https://hwbvbqmunjhkpefubfhq.supabase.co https://*.mux.com https://static.cloudflareinsights.com; frame-src https://player.mux.com https://player.vimeo.com; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'

# Fingerprinted build output never changes under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=2592000

/hero.mp4
  Cache-Control: public, max-age=2592000

# HTML is revalidated so a content change goes live on the next deploy.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
